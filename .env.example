# ==========================================
# 🟢 SOLANA RPC & WEBSOCKET SETTINGS
# ==========================================
# Your primary RPC endpoint for standard reads
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# Websocket endpoint for real-time updates and dump detection
WSS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# ==========================================
# 🚀 HELIUS STAKED SENDER TUNNEL (CRUCIAL)
# ==========================================
# This bypasses standard RPC queues and routes transactions directly to staked validators.
# WARNING: This requires a **Paid Helius Plan**. It will fail on the free tier.
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast?api-key=your_helius_api_key

# ==========================================
# 🛡️ JUPITER DUAL-KEY ARCHITECTURE
# ==========================================
# Jupiter's Free Tier enforces a strict 1 Request Per Second (RPS) limit.
# We split the load across two separate API keys to prevent price-polling from stealing bandwidth from trade-execution.
# 
# MUST be tied to a Paid Jupiter Plan for high-frequency polling.
JUPITER_PRICE_API_KEY=your_paid_jupiter_price_key_here

# Can remain on Free Plan for standard users, but Paid Plan is recommended for high-volume sniping.
JUPITER_QUOTE_API_KEY=your_jupiter_quote_key_here

# ==========================================
# 🔑 WALLET SETTINGS
# ==========================================
# Private key for the wallet executing trades (Base58 encoded string)
PRIVATE_KEY=your_wallet_private_key_here

# ==========================================
# 🤖 TELEGRAM BOT SETTINGS
# ==========================================
# Bot token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram Chat ID to receive alerts and manage trades
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==========================================
# ⚙️ TRADING PARAMETERS
# ==========================================
# Fixed amount of SOL to use per trade
AMOUNT=0.02
# Maximum slippage allowed (in percentage)
SLIPPAGE=5
# Maximum number of concurrent positions the bot will hold
MAX_POSITIONS=5
# Trailing stop-loss percentage (e.g., 20 means trailing 20% below highest price)
TRAILING_STOP=20

# ⏱️ ENGINE TUNING (Throttle)
# Adjust the polling interval based on your Jupiter API Tier:
# - Free Tier: Use 1100 (1.1 seconds)
# - Paid Tier: Drop to 500 or 250 for high-frequency updates
POLLING_INTERVAL_MS=1100
